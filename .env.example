# IBDIC ITN UAT application settings. Copy this file to .env before running tests.
BASE_URL=https://itn-uat.ibdic.in
LOGIN_EMAIL=your-email@example.com
LOGIN_PASSWORD=your-password
USER_2_EMAIL=second-user@example.com
USER_2_PASSWORD=second-user-password

ISSUANCE_CORPORATE_MAKER_EMAIL=corporate-maker@example.com
ISSUANCE_CORPORATE_MAKER_PASSWORD=corporate-maker-password
ISSUANCE_CORPORATE_CHECKER_EMAIL=corporate-checker@example.com
ISSUANCE_CORPORATE_CHECKER_PASSWORD=corporate-checker-password
ISSUANCE_BANK_CHECKER_EMAIL=bank-checker@example.com
ISSUANCE_BANK_CHECKER_PASSWORD=bank-checker-password
ISSUANCE_BANK_INPUTTER_EMAIL=bank-inputter@example.com
ISSUANCE_BANK_INPUTTER_PASSWORD=bank-inputter-password
ISSUANCE_BANK_AUTHORISER_EMAIL=bank-authoriser@example.com
ISSUANCE_BANK_AUTHORISER_PASSWORD=bank-authoriser-password

# Browser can be chromium, firefox, or webkit.
BROWSER=chromium
